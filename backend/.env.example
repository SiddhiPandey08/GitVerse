# Copy this file to .env and fill in the real values.
# Never commit the real .env — it is listed in .gitignore.

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
MONGODB_URI=
JWT_SECRET=
# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173,https://yourapp.com
CLIENT_ORIGIN=
PORT=
